{
  "name": "guild-manager-bot",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Discord bot for managing an Albion Online guild and community.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test": "node scripts/test.mjs",
    "db:smoke": "tsx src/db/smoke.ts",
    "runtime-lock:smoke": "tsx src/runtime/runtimeLockSmoke.ts"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "overrides": {
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
